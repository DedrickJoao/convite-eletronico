# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB database (e.g. MongoDB Atlas or cluster)
# Used for persistent guest RSVPs, messages, activity history, location tracking, and blockchain verification ledger.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/wedding_db?retryWrites=true&w=majority"

# OPTIONAL EMAIL NOTIFICATIONS (to bhelena.nhantumbo76@gmail.com):
# By default, confirmations are forwarded via FormSubmit and saved to local JSON + MongoDB.
# You can optionally provide Resend or direct SMTP credentials:
# RESEND_API_KEY="re_123456789"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-gmail-app-password"
